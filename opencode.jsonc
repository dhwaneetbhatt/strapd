{
  "$schema": "https://opencode.ai/config.json",
  // Shell permissions are not an OS sandbox. Unknown commands require approval.
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
    { "action": "shell", "resource": "rtk make *", "effect": "allow" },
    { "action": "shell", "resource": "rtk proxy make *", "effect": "allow" },
    { "action": "shell", "resource": "TZ=UTC make *", "effect": "allow" },
    { "action": "shell", "resource": "TZ=UTC rtk make *", "effect": "allow" },
    // Read-only inspection
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "rtk ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "rtk cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "rtk wc *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rtk grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rtk rg *", "effect": "allow" },
    { "action": "shell", "resource": "sed -n *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "rtk find *", "effect": "allow" },
    { "action": "shell", "resource": "find *-delete*", "effect": "ask" },
    { "action": "shell", "resource": "find *-exec*", "effect": "ask" },
    { "action": "shell", "resource": "rtk find *-delete*", "effect": "ask" },
    { "action": "shell", "resource": "rtk find *-exec*", "effect": "ask" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "rtk diff *", "effect": "allow" },
    { "action": "shell", "resource": "cmp *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "shasum *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git log *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git show *", "effect": "allow" },
    // Project tooling outside make (benchmarks, built binaries, skill scripts)
    { "action": "shell", "resource": "cargo bench *", "effect": "allow" },
    { "action": "shell", "resource": "rtk cargo bench *", "effect": "allow" },
    { "action": "shell", "resource": "cargo tree *", "effect": "allow" },
    { "action": "shell", "resource": "./target/debug/strapd *", "effect": "allow" },
    { "action": "shell", "resource": "./target/release/strapd *", "effect": "allow" },
    { "action": "shell", "resource": "node .agents/skills/impeccable/scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "openspec show *", "effect": "allow" },
    { "action": "shell", "resource": "openspec archive *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "git switch -c *", "effect": "allow" },
    { "action": "shell", "resource": "git switch --create *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout -b *", "effect": "allow" },
    { "action": "shell", "resource": "openspec instructions *", "effect": "allow" },
    { "action": "shell", "resource": "openspec list *", "effect": "allow" },
    { "action": "shell", "resource": "openspec new *", "effect": "allow" },
    { "action": "shell", "resource": "openspec status *", "effect": "allow" },
    { "action": "shell", "resource": "openspec validate *", "effect": "allow" },
    { "action": "shell", "resource": "openspec view *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue comment *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue create *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue edit *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue status *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr edit *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr ready *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr update-branch *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" }
  ],
  "agents": {
    "plan": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "coder": {
      "permissions": [
        { "action": "shell", "resource": "git add *", "effect": "deny" },
        { "action": "shell", "resource": "git commit *", "effect": "deny" },
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git switch *", "effect": "deny" },
        { "action": "shell", "resource": "git checkout *", "effect": "deny" }
      ]
    },
    "tester": {
      "permissions": [
        { "action": "shell", "resource": "git add *", "effect": "deny" },
        { "action": "shell", "resource": "git commit *", "effect": "deny" },
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git switch *", "effect": "deny" },
        { "action": "shell", "resource": "git checkout *", "effect": "deny" }
      ]
    }
  },
  "experimental": { "subagent_depth": 1 }
}
