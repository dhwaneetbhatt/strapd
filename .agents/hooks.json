{
  "impeccable-ui-check": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"skills/impeccable/scripts/hook.mjs\" ] || node \"skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"skills/impeccable/scripts/hook.mjs\" ] || node \"skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
