# Project-scoped commands used by strapd's documented development workflow.
# Keep global installs, release/publish operations, destructive Git commands
# other than explicitly allowed pushes, PR merges, hook installation, and
# GUI-opening targets approval-gated.

prefix_rule(
    pattern = [
        "make",
        [
            "help",
            "rust-fmt",
            "rust-fmt-check",
            "rust-lint",
            "rust-build",
            "cli-build",
            "cli-release",
            "rust-test",
            "rust-coverage",
            "rust-coverage-report",
            "wasm-build",
            "webapp-install",
            "webapp-fmt",
            "webapp-fmt-check",
            "webapp-lint",
            "webapp-dev",
            "webapp-build",
            "webapp-test",
            "webapp-coverage",
            "lint",
            "fmt",
            "fmt-check",
            "test",
            "coverage",
            "brew-formula-check",
        ],
    ],
    decision = "allow",
    justification = "Allow documented strapd build, formatting, lint, test, coverage, and local development targets.",
    match = [
        "make webapp-test",
        "make webapp-build",
        "make wasm-build",
        "make test",
    ],
    not_match = [
        "make setup",
        "make rust-install",
        "make install-hooks",
        "make webapp-coverage-open",
        "make brew-update-checksums",
    ],
)

prefix_rule(
    pattern = [
        "cargo",
        ["build", "check", "clippy", "fetch", "fmt", "run", "test"],
    ],
    decision = "allow",
    justification = "Allow standard Rust development commands without permitting global cargo installs or publishing.",
    match = [
        "cargo test",
        "cargo clippy -- -D warnings",
        "cargo run -p strapd -- --help",
    ],
    not_match = [
        "cargo install wasm-pack",
        "cargo publish",
    ],
)

prefix_rule(
    pattern = [
        "pnpm",
        ["biome", "build", "dev", "install", "test"],
    ],
    decision = "allow",
    justification = "Allow the webapp's declared package, build, formatting, development, and test commands.",
    match = [
        "pnpm install",
        "pnpm biome check",
        "pnpm test --run",
    ],
    not_match = [
        "pnpm add zod",
        "pnpm publish",
    ],
)

prefix_rule(
    pattern = ["wasm-pack", "build"],
    decision = "allow",
    justification = "Allow rebuilding strapd's local WASM package.",
    match = [
        "wasm-pack build crates/wasm",
    ],
    not_match = [
        "wasm-pack publish",
    ],
)

prefix_rule(
    pattern = [
        "openspec",
        ["instructions", "list", "new", "status", "validate", "view"],
    ],
    decision = "allow",
    justification = "Allow project-local OpenSpec planning and validation while keeping archive operations approval-gated.",
    match = [
        "openspec list --json",
        "openspec new change gh-123-example-change",
        "openspec validate gh-123-example-change",
    ],
    not_match = [
        "openspec archive gh-123-example-change",
    ],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow staging changes for commits in the strapd repository.",
    match = [
        "git add .codex/rules/strapd.rules",
        "git add -A",
    ],
    not_match = [
        "git reset --hard",
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow creating and amending local commits for the PR-gated workflow.",
    match = [
        "git commit -m update-rules",
        "git commit --amend --no-edit",
    ],
    not_match = [
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "Allow publishing feature-branch commits; repository branch protection and PR review remain the integration gate.",
    match = [
        "git push",
        "git push -u origin gh-27-example",
    ],
    not_match = [
        "git remote remove origin",
    ],
)

prefix_rule(
    pattern = ["git", "switch", ["-c", "--create"]],
    decision = "allow",
    justification = "Allow creating and switching to a feature branch.",
    match = [
        "git switch -c gh-27-example",
        "git switch --create gh-27-example",
    ],
    not_match = [
        "git switch main",
        "git branch -D gh-27-example",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "-b"],
    decision = "allow",
    justification = "Allow the legacy Git syntax for creating a feature branch.",
    match = [
        "git checkout -b gh-27-example",
    ],
    not_match = [
        "git checkout main",
        "git checkout -B main",
    ],
)

prefix_rule(
    pattern = [
        "gh",
        "issue",
        ["comment", "create", "edit", "list", "status", "view"],
    ],
    decision = "allow",
    justification = "Allow normal GitHub issue authoring and inspection while keeping close/delete actions gated.",
    match = [
        "gh issue view 123 --repo dhwaneetbhatt/strapd",
        "gh issue comment 123 --body progress",
        "gh issue create --title example --body details",
    ],
    not_match = [
        "gh issue close 123 --repo dhwaneetbhatt/strapd",
    ],
)

prefix_rule(
    pattern = [
        "gh",
        "pr",
        [
            "checks",
            "comment",
            "create",
            "diff",
            "edit",
            "list",
            "ready",
            "status",
            "update-branch",
            "view",
        ],
    ],
    decision = "allow",
    justification = "Allow normal PR creation, maintenance, and inspection while keeping merge, close, and review decisions gated.",
    match = [
        "gh pr create --title example --body details",
        "gh pr checks 30",
        "gh pr view 30",
    ],
    not_match = [
        "gh pr merge 30",
        "gh pr close 30",
        "gh pr review 30 --approve",
    ],
)
