package strapd:poc@0.0.0;

world tools {
    record detection {
        category: u32,
        start: u32,
        end: u32,
    }
    record sampled-array {
        path: string,
        omitted: u32,
    }
    record sample-result {
        output: string,
        filtered-nulls: u32,
        filtered-empty-arrays: u32,
        omitted-total: u32,
        arrays: list<sampled-array>,
    }
    export detect: func(input: string, categories: u8) -> list<detection>;
    export mask: func(input: string, categories: u8) -> string;
    export decode: func(input: string) -> result<list<u8>, string>;
    export sample: func(input: string, size: u32, seed: u64) -> result<sample-result, string>;
    export uuid: func(count: u32) -> result<string, string>;
    export timestamp: func(value: s64) -> result<string, string>;
}
